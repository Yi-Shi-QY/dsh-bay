      "delivery": "core-bundled",
      "coreCompatibility": "0.1.2",
      "activation": "restart-only",
      "dshGeneration": "0.2.2-rc.3",
      "candidateId": "dsh-bay-0.1.2-dsh-0.2.2-rc.3",
      "productLine": "DSH Bay 0.1.2",
      "upstreamCommit": "ddac96760b6edf8fa0fe17cbdcf0b512f4c12b2c",
      "morePolicy": "deferred-official-only",
      "defaultInstall": [
        "dsh-bay"
      ],
      "excludedModules": [
        "@dsh-workbench/conversation-suite",
        "@dsh-workbench/svgdeepseek-pet"
      ],
      "sourceDigest": "e9b1d5923b0a8d6541399db3421c85f72015e53eb117201ecc83e4eba16b80eb"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-context-menu"
