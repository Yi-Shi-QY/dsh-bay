{
  "name": "dsh-bay",
  "description": "DSH Bay multi-area workbench for developing, validating and sharing DSH plugins",
  "version": "0.1.2",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yi-Shi-QY/dsh-bay.git"
  },
  "homepage": "https://github.com/Yi-Shi-QY/dsh-bay",
  "bugs": {
    "url": "https://github.com/Yi-Shi-QY/dsh-bay/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bay",
    "workbench"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.2.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./dsh.bundle.patch.yml": "./dsh.bundle.patch.yml"
  },
  "scripts": {
    "build:types:host": "tsc -b tsconfig.host.json",
    "build:types:client": "tsc -b tsconfig.client.json",
    "build:types": "pnpm run build:types:host && pnpm run build:types:client",
    "bundle": "tsdown",
    "build": "node ../../scripts/build.mjs workbench-core"
  },
