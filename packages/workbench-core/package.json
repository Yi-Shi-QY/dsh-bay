    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "workbench": {
      "schemaVersion": 1,
      "moduleId": "workbench.core",
      "kind": "official-builtin",
      "delivery": "core-bundled",
      "coreCompatibility": "0.2.2-alpha.17.6",
      "activation": "restart-only",
      "dshGeneration": "0.2.2-rc.1",
      "candidateId": "dsh-bay-0.2.2-alpha.17.6-dsh-0.2.2-rc.1",
      "productLine": "DSH Bay 0.2.2-alpha.17.6",
      "upstreamCommit": "66491b05e3f05ad35bcdd4f6cd7ed26041d9e3db",
      "morePolicy": "deferred-official-only",
      "defaultInstall": [
        "dsh-bay"
      ],
      "excludedModules": [
        "@dsh-workbench/conversation-suite",
        "@dsh-workbench/svgdeepseek-pet"
      ],
      "sourceDigest": "1ddb4669dbcb52b0a3c93fa1dda418e26994ae83216979849efed76820cd86e3"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "officialMore": "host-only-rc1-ui-entry-customization"
    },
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "core-foundation-copy-manifest.json",
    "core-upstream-adaptation.json",
    "rc1-sidebar-workspace-source-index.json",
    "THIRD_PARTY_NOTICES.txt",
    "dsh.bundle.patch.yml",
    "README.md",
    "LICENSE",
    "presets/workbench-creator/skills/workbench-extension-development/**",
