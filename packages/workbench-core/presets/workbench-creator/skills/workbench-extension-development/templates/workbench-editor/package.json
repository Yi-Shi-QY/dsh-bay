{
  "name": "@local/workbench-editor-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    },
    "workbench": {
      "schemaVersion": 1,
      "moduleId": "workbench.editor-example",
      "kind": "extension",
      "delivery": "direct-source",
      "version": "0.1.0",
      "coreCompatibility": "0.2.2-alpha.17",
      "dshGeneration": "0.2.1-rc.5",
      "upstreamCommit": "b830ec950faba0a46dda564be3e2d854afed94f1",
      "activation": "restart-only",
      "scope": "root",
      "editorIds": ["workbench.example"],
      "permissions": [],
      "requiredCapabilities": [],
      "editors": [{
        "editorId": "workbench.example",
        "scope": "root",
        "label": "示例内页",
        "requiredBinding": "none",
        "binding": { "requirement": "none", "unbound": "available", "sharing": "none" },
        "state": { "schemaVersion": 1, "maxBytes": 16384, "restore": "if-valid", "share": "portable" },
        "runtime": { "background": "pause", "collapsed": "dispose", "reacquire": "on-visible" }
      }]
    }
  }
}
