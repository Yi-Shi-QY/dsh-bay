{
  "name": "areadeck-private-staging",
  "description": "Private staging repository for AreaDeck (随想域) on DSH",
  "private": true,
  "version": "0.2.2-alpha.17",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yi-Shi-QY/areadeck.git"
  },
  "homepage": "https://github.com/Yi-Shi-QY/areadeck",
  "bugs": {
    "url": "https://github.com/Yi-Shi-QY/areadeck/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workbench",
    "areadeck"
  ],
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:rc5": "node scripts/check-rc5.mjs",
    "verify": "pnpm check:rc5 && pnpm test && pnpm build",
    "test": "node scripts/test.mjs",
    "typecheck": "pnpm --filter @dsh-workbench/core build:types",
    "pack:core": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "anser": "2.3.5",
    "diff": "9.0.0",
    "esbuild": "0.27.4",
    "immer": "10.1.1",
    "jsdom": "29.1.1",
    "katex": "0.16.47",
    "lightningcss": "1.32.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-sanitize-uri": "2.0.1",
    "playwright": "1.58.2",
    "shiki": "4.3.1",
    "simple-icons": "16.31.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zustand": "4.4.7"
  }
}
